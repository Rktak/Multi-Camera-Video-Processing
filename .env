# ─────────────────────────────────────────────────────────────────
# MCMOT Environment Configuration
# DO NOT commit this file to version control (add .env to .gitignore)
# ─────────────────────────────────────────────────────────────────

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=mcmot_db

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
# URL-encoded password (admin@12 -> admin%4012)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/mcmot_db

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://localhost:8000

# ─── Optional Tuning ─────────────────────────────────────────────
# YOLO model to use (yolov8n=fastest, yolov8s/m=more accurate)
# TIP: Export to TensorRT for 3-5x speedup: yolo export model=yolov8n.pt format=engine half=True device=0
YOLO_MODEL=yolov8n.pt

# YOLO input resolution (640=default/accurate, 480=fast, 320=fastest)
# Smaller = faster detection with minimal accuracy loss for person detection
YOLO_IMGSZ=480

# Re-ID backbone model (osnet_ain=recommended, osnet, mobilenetv3=legacy)
REID_MODEL=osnet_ain

# Use FP16 (half-precision) for ReID model on CUDA (true=faster, false=more precise)
REID_HALF=true

# Default Re-ID cosine similarity threshold (0.0 to 1.0)
REID_THRESHOLD=0.80
